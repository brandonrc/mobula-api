{
  "openapi": "3.1.0",
  "info": {
    "title": "Mobula",
    "description": "FOSS control plane for Ray clusters. All endpoints take a Bearer JWT (OIDC). Note: the Ray Jobs API is NOT documented here — it is served by hostname, each registered cluster's hostname proxying Ray's own /api/jobs/ surface through the federating gateway. This spec covers Mobula's own control-plane routes.",
    "license": {
      "name": "Apache-2.0"
    },
    "version": "0.0.1"
  },
  "paths": {
    "/api/v1/clusters": {
      "get": {
        "tags": [
          "clusters"
        ],
        "operationId": "list_clusters",
        "responses": {
          "200": {
            "description": "All managed clusters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClusterView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Read on cluster"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "clusters"
        ],
        "operationId": "create_cluster",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCluster"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Desired state recorded; reconciler will converge"
          },
          "400": {
            "description": "Invalid spec (bad quantity, min>max)"
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Write on cluster (Operator/Admin only)"
          },
          "409": {
            "description": "Project quota exceeded"
          },
          "500": {
            "description": "Store/quota-accounting failure"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/clusters/{id}": {
      "get": {
        "tags": [
          "clusters"
        ],
        "operationId": "get_cluster",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Cluster id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The cluster",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterView"
                }
              }
            }
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Read on cluster"
          },
          "404": {
            "description": "No such cluster"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "clusters"
        ],
        "operationId": "delete_cluster",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Cluster id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Marked for termination; reconciler tears it down"
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Write on cluster (Operator/Admin only)"
          },
          "404": {
            "description": "No such cluster"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/jobs": {
      "get": {
