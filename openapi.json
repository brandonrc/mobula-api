              }
            }
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Read on job"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/metrics": {
      "get": {
        "tags": [
          "usage"
        ],
        "operationId": "metrics",
        "responses": {
          "200": {
            "description": "Prometheus text exposition of usage gauges",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Read on cluster"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/pools": {
      "get": {
        "tags": [
          "pools"
        ],
        "operationId": "list_pools",
        "responses": {
          "200": {
            "description": "All capacity pools",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PoolView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Read on pool"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "pools"
        ],
        "operationId": "create_pool",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePool"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Pool created"
          },
          "400": {
            "description": "Invalid spec (bad name, no flavors, unparseable quantity)"
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Write on pool (Admin only)"
          },
          "409": {
            "description": "Pool already exists (create-only in v0; spec update lands with a later PATCH)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/pools/{name}": {
      "get": {
        "tags": [
          "pools"
        ],
        "operationId": "get_pool",
        "parameters": [
          {
