            "description": "The pool",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolView"
                }
              }
            }
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Read on pool"
          },
          "404": {
            "description": "No such pool"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "pools"
        ],
        "operationId": "delete_pool",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Pool name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Pool deleted"
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Delete on pool (Admin only)"
          },
          "404": {
            "description": "No such pool"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/pools/{name}/allocations": {
