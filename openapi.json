            }
          }
        ],
        "responses": {
          "200": {
            "description": "Live pool utilization (latest observation)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolUsageView"
                }
              }
            }
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Read on pool"
          },
          "404": {
            "description": "No such pool"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
