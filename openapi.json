            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Write on pool (Admin only)"
          },
          "404": {
            "description": "No such pool"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "pools"
        ],
        "operationId": "delete_allocation",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Pool name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Allocation deleted"
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Delete on pool (Admin only)"
          },
          "404": {
            "description": "No such allocation"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
