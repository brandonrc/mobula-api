              }
            }
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Read on pool"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/pools/{name}/allocations/{project}": {
      "put": {
        "tags": [
          "pools"
        ],
        "operationId": "put_allocation",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Pool name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project",
            "in": "path",
            "description": "Project name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
