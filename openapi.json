          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/usage": {
      "get": {
        "tags": [
          "usage"
        ],
        "operationId": "usage_report",
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "description": "Filter to one project.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "pool",
            "in": "query",
            "description": "Filter to one pool.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Window start, unix seconds (default: `to - 86400`).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Window end, unix seconds (default: now).",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource-hours (and cost when priced) by project and pool",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageReport"
                }
              }
            }
          },
          "400": {
            "description": "from must be before to"
          },
          "401": {
            "description": "No/invalid token"
          },
          "403": {
            "description": "Missing Read on cluster"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Control-plane identity and version.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "Name and semver",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness/readiness probe.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Control plane is up",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AllocationSpec": {
        "type": "object",
        "description": "A project's allocation within a pool (translates to a Kueue LocalQueue).\n\n`nominal` / `borrowing_limit` / `lending_limit` are reserved for a future\nper-project ClusterQueue layout (ADR-0010): in the v0 layout all\nallocations in a pool share one ClusterQueue, so these are recorded as\nLocalQueue annotations rather than enforced quotas.",
        "required": [
          "pool",
          "project",
          "namespace",
          "nominal",
          "borrowing_limit",
          "lending_limit"
        ],
        "properties": {
          "borrowing_limit": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "lending_limit": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "namespace": {
            "type": "string"
          },
          "nominal": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "pool": {
            "type": "string"
          },
          "project": {
            "type": "string"
          }
        }
      },
      "ClusterSpec": {
        "type": "object",
        "description": "Declarative spec for a managed Ray cluster.\n\nv0 targets the KubeRay backend only; fields deliberately mirror what maps\nonto a RayCluster CR so the provisioner stays a thin translation.",
        "required": [
          "name",
          "project",
          "ray_version",
          "image",
          "head_cpu",
          "head_memory",
          "worker_groups"
        ],
        "properties": {
          "head_cpu": {
            "type": "string"
          },
          "head_memory": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "ray_version": {
            "type": "string"
          },
          "ttl_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Idle TTL in seconds; `None` disables reaping.",
            "minimum": 0
          },
          "worker_groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerGroup"
            }
          }
        }
      },
      "ClusterState": {
        "type": "string",
        "description": "Lifecycle states of a managed cluster (PLAN.md §3.1).",
        "enum": [
          "pending",
          "provisioning",
          "running",
          "degraded",
          "updating",
          "suspending",
          "suspended",
          "terminating",
          "terminated"
        ]
      },
      "ClusterView": {
        "type": "object",
        "description": "A cluster as the control plane sees it: desired spec metadata plus the\nlast observed state (reconstructed from the provisioner, ADR-0006).",
        "required": [
          "id",
          "generation",
          "desired",
          "observed_generation",
          "project",
          "ray_version"
        ],
        "properties": {
          "condition": {
            "type": [
              "string",
              "null"
            ],
            "description": "Drift/health alarm raised by the reconcile engine (ADR-0004, #41/#47):\n\"spec_drift\" (out-of-band edit) or \"degraded\". `None` when converging\nnormally. Distinct from `observed_state`."
          },
          "desired": {
            "type": "string",
            "description": "\"running\" | \"terminated\" — the operator's intent."
          },
          "est_max_hourly": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Estimated $/hr at max (fully scaled) size."
          },
          "est_min_hourly": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Estimated $/hr at min size, if a price sheet is configured."
          },
          "generation": {
            "type": "integer",
            "format": "int64",
            "description": "Bumps when the spec changes; drives the reconcile idempotency key.",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "observed_generation": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "observed_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Observed lifecycle state, if the cluster has been reconciled."
          },
          "project": {
            "type": "string"
          },
          "ray_version": {
            "type": "string"
          }
        }
      },
      "CreateCluster": {
        "type": "object",
        "description": "Request body for creating/updating a managed cluster.",
        "required": [
          "id",
          "spec"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable cluster id (also the gateway routing key / RayCluster name)."
          },
          "spec": {
            "$ref": "#/components/schemas/ClusterSpec"
          }
        }
      },
      "CreatePool": {
        "type": "object",
        "description": "Request body for creating a pool.",
        "required": [
          "spec"
        ],
        "properties": {
          "spec": {
            "$ref": "#/components/schemas/PoolSpec"
          }
        }
      },
      "DeployService": {
        "type": "object",
        "description": "Request body to deploy or update a service.",
        "required": [
          "name",
          "spec"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Stable service name (the RayService name)."
          },
          "spec": {
            "$ref": "#/components/schemas/ServiceSpec"
          }
        }
      },
      "FlavorSpec": {
        "type": "object",
        "description": "A hardware flavor within a pool: node selection plus per-resource\nnominal quota (K8s quantity strings, e.g. \"4\", \"512Gi\").",
        "required": [
          "name",
          "resources",
          "node_labels",
          "taints"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "node_labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "resources": {
            "type": "object",
            "description": "Resource key → nominal quota quantity string.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "taints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaintSpec"
            }
          }
        }
      },
      "JobView": {
        "type": "object",
        "description": "A job in the persistent, cross-cluster history (Phase 3, spec §5.5).",
        "required": [
          "id",
          "cluster",
          "submitter",
          "status",
          "submitted_at"
        ],
        "properties": {
          "cluster": {
            "type": "string"
          },
          "duration_secs": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Wall-clock seconds once terminal; null while running.",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Ray job status (PENDING | RUNNING | SUCCEEDED | FAILED | STOPPED)."
          },
          "submitted_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "submitter": {
            "type": "string"
          }
        }
      },
      "PoolSpec": {
        "type": "object",
        "description": "A shared capacity pool: flavors + a cohort to borrow from (ADR-0010).",
        "required": [
          "name",
          "flavors",
          "cohort",
          "fair_sharing_weight",
          "elastic"
        ],
        "properties": {
          "cohort": {
            "type": "string",
            "description": "Name of the Kueue cohort this pool's ClusterQueue joins for elastic\nborrowing."
          },
          "elastic": {
            "type": "boolean",
            "description": "Whether workloads in this pool may be elastically resized (Kueue\nelastic jobs / Workload Slices)."
          },
          "fair_sharing_weight": {
            "type": "number",
            "format": "double",
            "description": "Kueue `spec.fairSharing.weight` for the pool's ClusterQueue."
          },
          "flavors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlavorSpec"
            }
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PoolUsageView": {
        "type": "object",
        "description": "Live point-in-time usage of one pool (Slice 4): built from the pool's\nlatest stored ClusterQueue/LocalQueue observation plus the spec's\nnominal quotas. NOT a timeseries — for history use `GET /api/v1/usage`.\n`projects` is the per-LocalQueue (per-project) attribution; empty when\nthe observation predates per-LQ status or none exists.",
        "required": [
          "pool",
          "utilization",
          "projects"
        ],
        "properties": {
          "pool": {
            "type": "string"
          },
          "projects": {
            "type": "object",
            "description": "project → resource → allocated quantity.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              },
              "propertyNames": {
                "type": "string"
              }
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "sampled_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "When the observation was recorded (unix seconds); `null` until the\npool reconcile loop has observed this pool.",
            "minimum": 0
          },
          "utilization": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ResourceUtilization"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "PoolView": {
        "type": "object",
        "description": "A pool as the control plane serves it: the stored spec metadata plus\n`total_nominal`, the per-resource sum of all flavors' nominal quotas.",
        "required": [
          "name",
          "generation",
          "created_at",
          "flavors",
          "cohort",
          "fair_sharing_weight",
          "elastic",
          "total_nominal"
        ],
        "properties": {
          "cohort": {
            "type": "string"
          },
          "created_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "elastic": {
            "type": "boolean"
          },
          "fair_sharing_weight": {
            "type": "number",
            "format": "double"
          },
          "flavors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlavorSpec"
            }
          },
          "generation": {
            "type": "integer",
            "format": "int64",
            "description": "Bumps when the spec changes (same convention as clusters).",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "total_nominal": {
            "type": "object",
            "description": "Resource key → summed nominal quota across flavors, as a string.\nA resource key whose quantity fails to parse on ANY flavor is\nomitted entirely (a partial sum would misreport capacity); the\nfailure is logged. Display math only — the spec stays authoritative.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "PutAllocation": {
        "type": "object",
        "description": "Request body for putting an allocation: `AllocationSpec` minus\n`pool`/`project`, which come from the path. If the body still carries\nthem, they must match the path or the request is rejected.",
        "required": [
          "namespace",
          "nominal",
          "borrowing_limit",
          "lending_limit"
        ],
        "properties": {
          "borrowing_limit": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "lending_limit": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "namespace": {
            "type": "string"
          },
          "nominal": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "pool": {
            "type": [
              "string",
              "null"
            ]
          },
          "project": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ResourceUtilization": {
        "type": "object",
        "description": "One resource's live utilization within a pool: `allocated` is the Kueue\nreservation-ledger total (summed across flavors from the latest\nClusterQueue observation), `nominal` the summed flavor quotas from the\nspec, `pct` = allocated / nominal × 100 (0 when nominal is 0 — a\npercentage of nothing is undefined, and 0 keeps the type non-optional).",
        "required": [
          "allocated",
          "nominal",
          "pct"
        ],
        "properties": {
          "allocated": {
            "type": "number",
            "format": "double"
          },
          "nominal": {
            "type": "number",
            "format": "double"
          },
          "pct": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ServiceSpec": {
        "type": "object",
        "description": "Declarative spec for a managed Serve service.",
        "required": [
          "name",
          "project",
          "ray_version",
          "image",
          "serve_config_v2",
          "head_cpu",
          "head_memory",
          "worker_replicas",
          "worker_cpu",
          "worker_memory"
        ],
        "properties": {
          "head_cpu": {
            "type": "string"
          },
          "head_memory": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "ray_version": {
            "type": "string"
          },
          "serve_config_v2": {
            "type": "string",
            "description": "The Serve application config (KubeRay `serveConfigV2`), passed\nthrough verbatim as a YAML string — Mobula does not interpret it."
          },
          "upgrade": {
            "$ref": "#/components/schemas/UpgradeStrategy"
          },
          "worker_cpu": {
            "type": "string"
          },
          "worker_memory": {
            "type": "string"
          },
          "worker_replicas": {
            "type": "integer",
            "format": "int32",
            "description": "Fixed worker replicas backing the service (autoscaling of Serve\ndeployments is Ray Serve's own concern).",
            "minimum": 0
          }
        }
      },
      "ServiceView": {
        "type": "object",
        "required": [
          "name",
          "state"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "description": "Observed lifecycle state: provisioning | running | updating | ..."
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "External Serve endpoint base URL, when ready."
          }
        }
      },
      "TaintSpec": {
        "type": "object",
        "description": "A Kubernetes taint on a flavor's nodes. `effect` is e.g. \"NoSchedule\";\nvalidated non-empty here (the set of legal effects is Kubernetes', not\nours).",
        "required": [
          "key",
          "value",
          "effect"
        ],
        "properties": {
          "effect": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "UpgradeStrategy": {
        "type": "string",
        "description": "How to roll out a new version of a service.",
        "enum": [
          "canary",
          "in_place"
        ]
      },
      "UsageGroup": {
        "type": "object",
        "description": "One (project, pool) group of the usage report.",
        "required": [
          "project",
          "pool",
          "resource_hours"
        ],
        "properties": {
          "cost_usd": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Total cost in USD; `null` when no price sheet is configured."
          },
          "pool": {
            "type": "string",
            "description": "Empty string = the project has no allocation."
          },
          "project": {
            "type": "string",
            "description": "Empty string = the pool-level aggregate row (Kueue path only)."
          },
          "resource_hours": {
            "type": "object",
            "description": "resource → resource-hours over the window.",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "UsageReport": {
        "type": "object",
        "description": "Response of `GET /api/v1/usage`.",
        "required": [
          "from",
          "to",
          "groups"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageGroup"
            }
          },
          "to": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "VersionInfo": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Always \"mobula\".",
            "example": "mobula"
          },
          "version": {
            "type": "string",
            "description": "Control-plane semver.",
            "example": "0.0.1"
          }
        }
      },
      "WorkerGroup": {
        "type": "object",
        "description": "A homogeneous group of Ray worker nodes.\n\nAutoscaling in v0 is actuated exclusively through these replica bounds,\nwhich translate to KubeRay worker-group fields — never by reading demand\nfrom GCS (ADR-0002).",
        "required": [
          "name",
          "cpu",
          "memory",
          "min_replicas",
          "max_replicas",
          "replicas"
        ],
        "properties": {
          "cpu": {
            "type": "string"
          },
          "gpu": {
            "type": [
              "string",
              "null"
            ]
          },
          "max_replicas": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "memory": {
            "type": "string"
          },
          "min_replicas": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "replicas": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health and version probes."
    },
    {
      "name": "clusters",
      "description": "Cluster lifecycle. Reads need any authenticated role; create/terminate need Write on the cluster target (Operator or Admin). Mounted only when the lifecycle controller is enabled (`serve --kuberay-namespace`)."
    },
    {
      "name": "services",
      "description": "Ray Serve services (RayService). Deploy/update/delete need Write on the service target (Developer or Admin — deploying is code); reads are open to any authenticated role. KubeRay handles zero-downtime canary rollout."
    },
    {
      "name": "pools",
      "description": "Capacity pools and per-project allocations (ADR-0010): platform configuration, not app lifecycle. Reads need any authenticated role; create/delete/allocation mutations are Admin-only. Mounted only when a store is configured."
    },
    {
      "name": "usage",
      "description": "Usage metering (Slice 4): resource-hours reports and the Prometheus gauge over the metered samples. Reads need Read on the cluster target (Viewer+) — consumption reporting is cluster data, not pool topology. Mounted only when a store is configured."
    }
  ]
}
